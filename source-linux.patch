+#[cfg(target_os = "linux")]
+fn linux_cursor_argv_files() -> Vec<PathBuf> {
+    // A systemd user service may not carry XDG_CONFIG_HOME even though the
+    // installer had it, so both the XDG location and the historical
+    // ~/.config/Cursor/argv.json stay readable.
+    let mut files = Vec::new();
+    if let Some(config) = std::env::var_os("XDG_CONFIG_HOME").map(PathBuf::from) {
+        files.push(config.join("Cursor").join("argv.json"));
+    }
+    if let Some(home) = dirs::home_dir() {
+        let fallback = home.join(".config").join("Cursor").join("argv.json");
+        if !files.contains(&fallback) {
+            files.push(fallback);
+        }
+    }
+    files
+}
